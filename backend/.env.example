# Kopiere diese Datei nach ".env" und passe die Werte an.
PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant

# Geheimnis zum Signieren der Anmelde-Cookies (Pflicht in Produktion).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Bei HTTPS auf true setzen
COOKIE_SECURE=false
